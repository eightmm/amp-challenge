{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eightmm/amp-challenge/schema/hemolysis_measurement.schema.json",
  "title": "Normalized interval-aware AMP HC50 measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "measurement_id",
    "sequence_id",
    "sequence",
    "n_terminal",
    "c_terminal",
    "endpoint",
    "relation",
    "unit_original",
    "unit_normalized",
    "lower_um",
    "upper_um",
    "source_name",
    "source_record_id",
    "cluster_id",
    "fold",
    "split_role"
  ],
  "properties": {
    "measurement_id": { "type": "string", "pattern": "^hc50-[0-9a-f]{20}$" },
    "sequence_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sequence": { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$" },
    "n_terminal": { "enum": ["free", "acetylated"] },
    "c_terminal": { "enum": ["free", "amidated"] },
    "source_name": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_row": { "type": "integer", "minimum": 2 },
    "cell_source": { "type": ["string", "null"] },
    "endpoint": { "const": "HC50" },
    "relation": { "enum": ["eq", "interval", "lt", "le", "gt", "ge"] },
    "value_original_low": { "type": "number", "exclusiveMinimum": 0 },
    "value_original_high": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "unit_original": { "type": "string", "minLength": 1 },
    "unit_normalized": { "enum": ["uM", "mM", "nM", "pmol/mL", "ug/mL", "mg/L", "ng/mL", "mg/mL"] },
    "lower_um": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "upper_um": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "lower_log2_um": { "type": ["number", "null"] },
    "upper_log2_um": { "type": ["number", "null"] },
    "safe_ge_64um": { "type": ["integer", "null"], "enum": [0, 1, null] },
    "safe_ge_128um": { "type": ["integer", "null"], "enum": [0, 1, null] },
    "replicate_count": { "type": "integer", "minimum": 1 },
    "pubmed_id": { "type": ["string", "null"] },
    "cluster_id": { "type": "string", "pattern": "^cluster-[0-9a-f]{16}$" },
    "fold": { "type": "integer", "minimum": 0 },
    "split_role": { "enum": ["train", "calibration", "test"] }
  },
  "anyOf": [
    { "properties": { "lower_um": { "type": "number" } } },
    { "properties": { "upper_um": { "type": "number" } } }
  ]
}
